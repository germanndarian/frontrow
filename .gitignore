# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brainstorming visual companion
.superpowers/

# Capacitor / Xcode native project (the project itself IS committed).
# Capacitor 8 uses Swift Package Manager, so there is no Pods directory.
ios/App/build/
ios/App/.swiftpm/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/

# Native SwiftUI app (apple/). The xcodeproj is generated by xcodegen from
# apple/project.yml and committed for convenience; user state and builds aren't.
apple/*.xcodeproj/xcuserdata/
apple/*.xcodeproj/project.xcworkspace/xcuserdata/
apple/build/
apple/DerivedData/
apple/.swiftpm/
